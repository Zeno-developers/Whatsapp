{
  "name": "whatsapp-service",
  "version": "1.0.2",
  "description": "WhatsApp messaging microservice for GMR",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon --exec 'npx -y node@20' --ignore .wa_auth/ --ignore wa_qr.png --ignore wa_status.txt --ignore msg_store.json index.js",
    "prod": "NODE_ENV=production nodemon --ignore .wa_auth/ --ignore wa_qr.png --ignore wa_status.txt --ignore msg_store.json index.js",
    "install:host": "bash ./scripts/install.sh",
    "start:host": "bash ./scripts/start.sh",
    "dev:system-node": "nodemon --ignore .wa_auth/ --ignore wa_qr.png --ignore wa_status.txt --ignore msg_store.json index.js"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^6.7.24",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "link-preview-js": "^3.2.0",
    "node-cron": "^3.0.3",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0"
  }
}
